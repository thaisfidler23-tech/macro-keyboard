{
  "name": "macro-keyboard-update-server",
  "version": "1.0.0",
  "description": "Update server for Macro Keyboard application with staged rollouts and A/B testing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "docker:build": "docker build -t macro-keyboard-update-server .",
    "docker:run": "docker run -p 3000:3000 macro-keyboard-update-server"
  },
  "keywords": [
    "update-server",
    "rollout-management",
    "ab-testing",
    "cdn",
    "analytics"
  ],
  "author": "Jenna Massardo",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "multer": "^1.4.5-lts.1",
    "crypto": "^1.0.1",
    "semver": "^7.7.2",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.0",
    "aws-sdk": "^2.1506.0",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "@types/jest": "^29.5.8"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}