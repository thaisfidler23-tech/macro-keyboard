{
  "name": "macro-keyboard",
  "version": "1.0.1",
  "description": "Electron based application to drive a physical macro keyboard.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "icons:generate": "node scripts/generate-icons.js",
    "icons:validate": "node scripts/generate-icons.js --validate",
    "prebuild": "npm run icons:generate"
  },
  "keywords": [
    "macro-keyboard",
    "arduino",
    "electron",
    "automation",
    "hardware"
  ],
  "author": "Jenna Massardo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sharp": "^0.33.1"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.4",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@serialport/parser-readline": "^12.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "caldav-adapter": "^8.2.11",
    "electron-updater": "^6.6.2",
    "googleapis": "^160.0.0",
    "js-yaml": "^4.1.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "robotjs": "^0.6.0",
    "semver": "^7.7.2",
    "serialport": "^12.0.0",
    "winston": "^3.11.0"
  },
  "build": {
    "appId": "com.massardo.macrokeyboard",
    "productName": "Macro Keyboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/default.yaml",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "jmassardo",
      "repo": "macro-keyboard"
    },
    "icon": "src/assets/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "src/assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "src/assets/icon.png"
    }
  }
}
