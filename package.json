{
  "name": "macro-keyboard",
  "version": "1.0.1",
  "description": "Electron based application to drive a physical macro keyboard.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:check": "eslint src/ --max-warnings 0",
    "lint:security": "eslint src/ --ext .js --config eslint-security.config.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\"",
    "quality": "npm run lint:check && npm run format:check",
    "quality:fix": "npm run format && npm run lint:fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "node tests/e2e/run-e2e-tests.js",
    "test:e2e:critical": "npx playwright test tests/e2e/critical-paths --config=playwright.config.js",
    "test:e2e:journeys": "npx playwright test tests/e2e/user-journeys --config=playwright.config.js",
    "test:e2e:platform": "npx playwright test tests/e2e/cross-platform --config=playwright.config.js",
    "test:e2e:debug": "npx playwright test --debug tests/e2e/critical-paths",
    "test:all": "npm run test:ci && npm run test:e2e",
    "validate": "npm run quality && npm run test:ci",
    "precommit": "npm run quality:fix && npm run test:ci",
    "icons:generate": "node scripts/generate-icons.js",
    "icons:validate": "node scripts/generate-icons.js --validate",
    "prebuild": "npm run icons:generate && npm run validate"
  },
  "keywords": [
    "macro-keyboard",
    "arduino",
    "electron",
    "automation",
    "hardware"
  ],
  "author": "Jenna Massardo",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.58.2",
    "electron": "^41.10.3",
    "electron-builder": "^26.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^27.0.0",
    "jsdom-global": "^3.0.2",
    "jshint": "^2.13.6",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "sharp": "^0.33.1"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.4",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@serialport/parser-readline": "^12.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "caldav-adapter": "^8.2.11",
    "electron-updater": "^6.6.2",
    "googleapis": "^160.0.0",
    "js-yaml": "^4.1.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "robotjs": "^0.6.0",
    "semver": "^7.7.2",
    "serialport": "^12.0.0",
    "winston": "^3.11.0"
  },
  "build": {
    "appId": "com.massardo.macrokeyboard",
    "productName": "Macro Keyboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/default.yaml",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "jmassardo",
      "repo": "macro-keyboard"
    },
    "icon": "src/assets/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "src/assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "src/assets/icon.png"
    }
  }
}
