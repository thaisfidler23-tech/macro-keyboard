{
  "id": "email_triage_workflow",
  "name": "Email Triage Workflow",
  "description": "Streamline email management with automated sorting, quick responses, and organization",
  "category": "productivity",
  "author": "MacroKeyboard Team",
  "version": "1.0.0",
  "tags": ["email", "productivity", "triage", "organization"],
  "parameters": [
    {
      "name": "email_client",
      "type": "select",
      "description": "Your preferred email client",
      "options": ["outlook", "gmail", "apple_mail", "thunderbird"],
      "default": "outlook",
      "required": true
    },
    {
      "name": "priority_folder",
      "type": "text",
      "description": "Name of your high priority folder",
      "default": "Priority",
      "maxLength": 50
    },
    {
      "name": "archive_folder",
      "type": "text", 
      "description": "Name of your archive folder",
      "default": "Archive",
      "maxLength": 50
    }
  ],
  "sequence": [
    {
      "type": "keypress",
      "action": "{{email_client === 'outlook' ? 'ctrl+1' : 'cmd+1'}}",
      "delay": 500,
      "description": "Switch to inbox view"
    },
    {
      "type": "keypress",
      "action": "{{email_client === 'gmail' ? 'g+i' : 'ctrl+shift+i'}}",
      "delay": 300,
      "description": "Select first unread email"
    },
    {
      "type": "keypress",
      "action": "{{email_client === 'outlook' ? 'ctrl+shift+g' : 'cmd+shift+1'}}",
      "delay": 200,
      "description": "Flag as important if needed",
      "condition": {
        "parameter": "priority_folder",
        "operator": "exists"
      }
    },
    {
      "type": "keypress",
      "action": "r",
      "delay": 300,
      "description": "Reply to email"
    },
    {
      "type": "text_input",
      "text": "Thank you for your email. I will review this and get back to you shortly.",
      "delay": 100,
      "description": "Standard response template"
    },
    {
      "type": "keypress",
      "action": "{{email_client === 'outlook' ? 'ctrl+enter' : 'cmd+enter'}}",
      "delay": 500,
      "description": "Send reply"
    },
    {
      "type": "keypress",
      "action": "escape",
      "delay": 200,
      "description": "Return to inbox"
    },
    {
      "type": "keypress",
      "action": "{{email_client === 'gmail' ? 'e' : 'ctrl+e'}}",
      "delay": 300,
      "description": "Archive processed email"
    }
  ],
  "requirements": {
    "platforms": ["windows", "macos", "linux"],
    "applications": ["Microsoft Outlook", "Gmail", "Apple Mail", "Thunderbird"],
    "hardware": ["basic"]
  }
}