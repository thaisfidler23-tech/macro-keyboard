{
  "id": "document_quick_access",
  "name": "Document Quick Access",
  "description": "Rapidly open frequently used files, folders, and document templates",
  "category": "productivity",
  "author": "MacroKeyboard Team",
  "version": "1.0.0",
  "tags": ["documents", "files", "quick-access", "productivity", "organization"],
  "parameters": [
    {
      "name": "document_paths",
      "type": "list",
      "description": "List of frequently accessed document paths",
      "default": [
        "~/Documents/Projects",
        "~/Documents/Templates", 
        "~/Desktop"
      ],
      "maxItems": 10
    },
    {
      "name": "file_manager",
      "type": "select",
      "description": "Your preferred file manager",
      "options": ["finder", "explorer", "nautilus", "dolphin"],
      "default": "finder",
      "platformMappings": {
        "macos": {
          "finder": "Finder"
        },
        "windows": {
          "explorer": "explorer.exe"
        },
        "linux": {
          "nautilus": "nautilus",
          "dolphin": "dolphin"
        }
      }
    },
    {
      "name": "open_in_new_window",
      "type": "boolean",
      "description": "Open each location in a new window",
      "default": true
    }
  ],
  "sequence": [
    {
      "type": "keypress",
      "action": "cmd+space",
      "delay": 300,
      "description": "Open Spotlight/Run dialog"
    },
    {
      "type": "text_input",
      "text": "{{file_manager}}",
      "delay": 200,
      "description": "Type file manager name"
    },
    {
      "type": "keypress",
      "action": "return",
      "delay": 1000,
      "description": "Launch file manager"
    },
    {
      "type": "keypress",
      "action": "{{process.platform === 'darwin' ? 'cmd+shift+g' : 'ctrl+l'}}",
      "delay": 500,
      "description": "Open 'Go to folder' dialog"
    },
    {
      "type": "text_input",
      "text": "{{document_paths[0]}}",
      "delay": 100,
      "description": "Enter first document path",
      "expandParameter": "document_paths",
      "parameterExpansion": true
    },
    {
      "type": "keypress",
      "action": "return",
      "delay": 500,
      "description": "Navigate to folder"
    },
    {
      "type": "keypress",
      "action": "{{open_in_new_window ? (process.platform === 'darwin' ? 'cmd+n' : 'ctrl+n') : 'alt+up'}}",
      "delay": 300,
      "description": "Open new window or go up a level based on preference"
    }
  ],
  "requirements": {
    "platforms": ["windows", "macos", "linux"],
    "applications": ["Finder", "Windows Explorer", "Nautilus", "Dolphin"],
    "hardware": ["basic"]
  }
}